{"nodes": [{"id": "dynamic_color_scheme_hct_color_space", "label": "HCT Color Space", "file_type": "document", "source_file": "concepts/dynamic_color_scheme.md", "source_location": null, "source_url": "https://m3.material.io/styles/color/system/how-the-system-works", "captured_at": null, "author": null, "contributor": null, "rationale": "HCT was chosen because it enables flexible, predictable color manipulation while providing perceptually meaningful dimensions (hue, chroma, tone). Traditional spaces like RGB do not adequately capture relationships between colors, whereas HCT supports both accessibility (via tone-based contrast) and expressive design."}, {"id": "dynamic_color_scheme_dynamic_scheme", "label": "DynamicScheme (Concept)", "file_type": "document", "source_file": "concepts/dynamic_color_scheme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DynamicScheme abstracts exact color values from app developers, who only choose color roles. This separation allows the system to swap underlying tonal palette values without breaking UI structure."}, {"id": "dynamic_color_scheme_color_roles", "label": "Color Roles", "file_type": "document", "source_file": "concepts/dynamic_color_scheme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dynamic_color_scheme_design_tokens", "label": "Design Tokens", "file_type": "document", "source_file": "concepts/dynamic_color_scheme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dynamic_color_scheme_source_color", "label": "Source Color", "file_type": "document", "source_file": "concepts/dynamic_color_scheme.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dynamic_color_scheme_tonal_palette", "label": "Tonal Palette (Concept)", "file_type": "document", "source_